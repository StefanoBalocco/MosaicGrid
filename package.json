{
  "name": "@stefanobalocco/mosaicgrid",
  "description": "Masonry-like effect using grid",
  "version": "3.0.0",
  "type": "module",
  "types": "dist/MosaicGrid.d.ts",
  "exports": {
    ".": {
      "types": "./dist/MosaicGrid.d.ts",
      "default": "./dist/MosaicGrid.min.js"
    }
  },
  "files": [
    "dist/MosaicGrid.js",
    "dist/MosaicGrid.min.js",
    "dist/MosaicGrid.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanoBalocco/MosaicGrid"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mosaic",
    "layout",
    "grid",
    "masonry"
  ],
  "author": "Stefano Balocco <stefano.balocco@gmail.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/StefanoBalocco/MosaicGrid/issues"
  },
  "homepage": "https://github.com/StefanoBalocco/MosaicGrid",
  "scripts": {
    "build": "tsBuild all",
    "build:library": "tsBuild library",
    "build:tests": "tsBuild tests",
    "tests": "c8 --include=src --include=dist --exclude-after-remap --per-file --reporter=text --reporter=lcov ava 'tests/dist/*.test.js' --verbose"
  },
  "devDependencies": {
    "@stefanobalocco/tsbuild": "^1",
    "@types/jsdom": "^28",
    "ava": "^8",
    "c8": "^12",
    "jsdom": "^28"
  }
}
